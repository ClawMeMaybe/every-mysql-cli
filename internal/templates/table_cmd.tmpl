func {{.Table.Name}}ListCmd() *cobra.Command {
	cmd := &cobra.Command{
		Use:   "list",
		Short: "List rows from {{.Table.Name}}",
		RunE: func(cmd *cobra.Command, args []string) error {
			query := "SELECT * FROM {{.Table.Name}}"
			var conditions []string
			var argValues []interface{}

{{range .Table.Columns}}
			if {{$.Table.Name}}Filter_{{.Name}} != "" {
				conditions = append(conditions, "{{.Name}} = ?")
{{if eq .GoType "int64"}}
				v, _ := strconv.ParseInt({{$.Table.Name}}Filter_{{.Name}}, 10, 64)
				argValues = append(argValues, v)
{{else if eq .GoType "float64"}}
				v, _ := strconv.ParseFloat({{$.Table.Name}}Filter_{{.Name}}, 64)
				argValues = append(argValues, v)
{{else}}
				argValues = append(argValues, {{$.Table.Name}}Filter_{{.Name}})
{{end}}
			}
{{if eq .GoType "string"}}
			if {{$.Table.Name}}Filter_{{.Name}}_like != "" {
				conditions = append(conditions, "{{.Name}} LIKE ?")
				argValues = append(argValues, {{$.Table.Name}}Filter_{{.Name}}_like)
			}
{{end}}
{{end}}

{{range .Table.ForeignKeys}}
			if {{$.Table.Name}}Filter_by_{{.ReferencedTable}} != "" {
				conditions = append(conditions, "{{.Column}} = ?")
{{if eq (indexColumnGoType $.Table .Column) "int64"}}
				v, _ := strconv.ParseInt({{$.Table.Name}}Filter_by_{{.ReferencedTable}}, 10, 64)
				argValues = append(argValues, v)
{{else}}
				argValues = append(argValues, {{$.Table.Name}}Filter_by_{{.ReferencedTable}})
{{end}}
			}
{{end}}

			if len(conditions) > 0 {
				query += " WHERE " + joinStrings(conditions, " AND ")
			}

			if {{.Table.Name}}OrderBy != "" {
				query += " ORDER BY " + {{.Table.Name}}OrderBy
				if {{.Table.Name}}OrderDir != "" {
					query += " " + {{.Table.Name}}OrderDir
				}
			}

			query += fmt.Sprintf(" LIMIT %d OFFSET %d", {{.Table.Name}}Limit, {{.Table.Name}}Offset)

			if {{.Table.Name}}DryRun {
				fmt.Println("SQL:", query)
				return nil
			}

			rows, err := db.Query(query, argValues...)
			if err != nil {
				renderError(err.Error(), "QUERY_ERROR")
				return nil
			}
			defer rows.Close()

			results := scanRows(rows, nil)
			total := len(results)
			renderList(results, total, {{.Table.Name}}Limit, {{.Table.Name}}Offset)
			return nil
		},
	}

	cmd.Flags().IntVar(&{{.Table.Name}}Limit, "limit", 100, "Limit rows")
	cmd.Flags().IntVar(&{{.Table.Name}}Offset, "offset", 0, "Offset rows")
	cmd.Flags().StringVar(&{{.Table.Name}}OrderBy, "order-by", "", "Order by column")
	cmd.Flags().StringVar(&{{.Table.Name}}OrderDir, "order-dir", "", "Order direction (asc/desc)")
	cmd.Flags().BoolVar(&{{.Table.Name}}DryRun, "dry-run", false, "Print SQL without executing")

{{range .Table.Columns}}
	cmd.Flags().StringVar(&{{$.Table.Name}}Filter_{{.Name}}, "{{.Name}}", "", "Filter by {{.Name}}")
{{if eq .GoType "string"}}
	cmd.Flags().StringVar(&{{$.Table.Name}}Filter_{{.Name}}_like, "{{.Name}}_like", "", "Filter {{.Name}} with LIKE pattern")
{{end}}
{{end}}

{{range .Table.ForeignKeys}}
	cmd.Flags().StringVar(&{{$.Table.Name}}Filter_by_{{.ReferencedTable}}, "by-{{.ReferencedTable}}", "", "Filter by FK to {{.ReferencedTable}} ({{.Column}})")
{{end}}

	return cmd
}


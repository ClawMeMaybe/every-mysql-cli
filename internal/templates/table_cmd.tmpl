func {{.Table.Name}}GetCmd() *cobra.Command {
	cmd := &cobra.Command{
		Use:   "get [id]",
		Short: "Get a single {{.Table.Name}} row by primary key",
		Args:  cobra.ExactArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			pkVal := args[0]
			query := "SELECT * FROM {{.Table.Name}} WHERE {{(indexPK .Table 0)}} = ?"

			if {{.Table.Name}}DryRun {
				fmt.Println("SQL:", query, "with arg:", pkVal)
				return nil
			}

			row := db.QueryRow(query, pkVal)
			result, err := scanSingleRow(row, nil)
			if err != nil {
				if err == sql.ErrNoRows {
					renderError("row not found", "NOT_FOUND")
					return nil
				}
				renderError(err.Error(), "QUERY_ERROR")
				return nil
			}

{{range .Table.ReferencedBy}}
			if {{$.Table.Name}}With_{{.SourceTable}} {
				relatedRows, relErr := db.Query("SELECT * FROM {{.SourceTable}} WHERE {{.SourceColumn}} = ?", pkVal)
				if relErr != nil {
					result["{{.SourceTable}}"] = map[string]string{"error": relErr.Error()}
				} else {
					defer relatedRows.Close()
					result["{{.SourceTable}}"] = scanRows(relatedRows, nil)
				}
			}
{{end}}

			renderSingle(result)
			return nil
		},
	}

	cmd.Flags().BoolVar(&{{.Table.Name}}DryRun, "dry-run", false, "Print SQL without executing")
{{range .Table.ReferencedBy}}
	cmd.Flags().BoolVar(&{{$.Table.Name}}With_{{.SourceTable}}, "with-{{.SourceTable}}", false, "Eager-load related {{.SourceTable}}")
{{end}}

	return cmd
}


func {{.Table.Name}}DeleteCmd() *cobra.Command {
	cmd := &cobra.Command{
		Use:   "delete [id]",
		Short: "Delete a {{.Table.Name}} row by primary key (requires --force)",
		Args:  cobra.MaximumNArgs(1),
		RunE: func(cmd *cobra.Command, args []string) error {
			if {{.Table.Name}}DeleteAll {
				requireForceWithConfirm("I understand this deletes all rows")
				query := "DELETE FROM {{.Table.Name}}"
				if {{.Table.Name}}DeleteDryRun {
					fmt.Println("SQL:", query)
					return nil
				}
				result, err := db.Exec(query)
				if err != nil {
					renderError(err.Error(), "QUERY_ERROR")
					return nil
				}
				rowsAffected, _ := result.RowsAffected()
				renderSuccess(fmt.Sprintf("Deleted %d row(s) from {{.Table.Name}}", rowsAffected))
				return nil
			}

			if len(args) == 0 {
				renderError("provide a primary key value or use --all", "MISSING_ARG")
				return nil
			}

			requireForce("delete")

			pkVal := args[0]
			query := "DELETE FROM {{.Table.Name}} WHERE {{(indexPK .Table 0)}} = ?"

			if {{.Table.Name}}DeleteDryRun {
				fmt.Println("SQL:", query, "with arg:", pkVal)
				return nil
			}

			result, err := db.Exec(query, pkVal)
			if err != nil {
				renderError(err.Error(), "QUERY_ERROR")
				return nil
			}

			rowsAffected, _ := result.RowsAffected()
			renderSuccess(fmt.Sprintf("Deleted %d row(s) from {{.Table.Name}}", rowsAffected))
			return nil
		},
	}

	cmd.Flags().BoolVar(&{{.Table.Name}}DeleteDryRun, "dry-run", false, "Print SQL without executing")
	cmd.Flags().BoolVar(&{{.Table.Name}}DeleteAll, "all", false, "Delete all rows (requires --force --confirm)")
	cmd.Flags().BoolVar(&forceFlag, "force", false, "Force destructive operation")
	cmd.Flags().StringVar(&confirmValue, "confirm", "", "Confirm destructive operation with message")

	return cmd
}

